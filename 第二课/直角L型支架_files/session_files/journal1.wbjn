# encoding: utf-8
# 2022 R2
SetScriptVersion(Version="22.2.192")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = template1.CreateSystem()
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath="C:/新建文件夹 (2)/课程/ANSYS学习素材/第二课/几何模型/L bracket无圆角.x_t")
system1.DisplayText = "第二课 10mm"
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
system1.Copy(KeepConnections=True)
system2 = GetSystem(Name="SYS 1")
system2.DisplayText = "第二课 3mm"
model2 = system2.GetContainer(ComponentName="Model")
model2.Edit()
model2.Exit()
model1.Exit()
Save(Overwrite=True)
ExportReport(FilePath="C:/Users/chenq/My Work/Finite Element Analysis/第二课/直角L型支架_report.html")
unitSystem1 = SetProjectUnitSystem(UnitSystemName="NMMTON_STANDARD")
Save(Overwrite=True)
